      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0631\u062f / \u0627\u0644\u062c\u0647\u0629"
    },
    "to_account_id": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u062f\u0641\u0648\u0639 \u0644\u0647 (ID)"
    },
    "to_account_code": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0648\u0631\u062f"
    },
    "to_account_name": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0648\u0631\u062f / \u0627\u0644\u0645\u0635\u0631\u0648\u0641"
    },
    "from_account_id": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0635\u0646\u062f\u0648\u0642/\u0627\u0644\u0628\u0646\u0643 (ID)"
    },
    "from_account_code": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u062d\u0633\u0627\u0628 \u0627\u0644\u0635\u0646\u062f\u0648\u0642/\u0627\u0644\u0628\u0646\u0643"
    },
    "from_account_name": {
      "type": "string",
      "title": "\u062d\u0633\u0627\u0628 \u0627\u0644\u0635\u0646\u062f\u0648\u0642/\u0627\u0644\u0628\u0646\u0643"
    },
