{
  "name": "Asset",
  "type": "object",
  "properties": {
    "asset_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0623\u0635\u0644"
    },
    "asset_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0623\u0635\u0644",
      "enum": [
        "\u0623\u062c\u0647\u0632\u0629 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629",
        "\u0623\u062f\u0648\u0627\u062a \u0645\u0643\u062a\u0628\u064a\u0629",
        "\u0645\u0639\u062f\u0627\u062a \u062a\u0634\u063a\u064a\u0644",
        "\u0623\u062e\u0631\u0649"
      ],
      "default": "\u0623\u062e\u0631\u0649"
    },
    "asset_code": {
      "type": "string",
      "title": "\u0643\u0648\u062f \u0627\u0644\u0623\u0635\u0644 (Asset ID)"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641"
    },
    "category": {
      "type": "string",
      "title": "\u0627\u0644\u062a\u0635\u0646\u064a\u0641"
    },
    "serial_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u062a\u0633\u0644\u0633\u0644\u064a"
    },
    "brand": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0644\u0627\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629"
    },
    "model": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u062f\u064a\u0644"
    },
    "purchase_price": {
      "type": "number",
      "title": "\u0633\u0639\u0631 \u0627\u0644\u0634\u0631\u0627\u0621",
      "default": 0
    },
    "supplier_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0631\u062f"
    },
    "invoice_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0641\u0627\u062a\u0648\u0631\u0629"
    },
    "warranty_period": {
      "type": "string",
      "title": "\u0645\u062f\u0629 \u0627\u0644\u0636\u0645\u0627\u0646"
    },
    "condition": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0641\u0639\u0644\u064a\u0629",
      "enum": [
        "\u062c\u062f\u064a\u062f",
        "\u062c\u064a\u062f",
        "\u062a\u0627\u0644\u0641"
      ],
      "default": "\u062c\u062f\u064a\u062f"
    },
    "status": {
      "type": "string",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0623\u0635\u0644",
      "enum": [
        "\u0645\u062a\u0627\u062d",
        "\u0645\u062e\u0635\u0635",
        "\u0635\u064a\u0627\u0646\u0629"
      ],
      "default": "\u0645\u062a\u0627\u062d"
    },
    "assigned_to_employee_id": {
      "type": "string",
      "title": "\u0645\u062e\u0635\u0635 \u0644\u0644\u0645\u0648\u0638\u0641 (ID)"
    },
    "assigned_to_employee_name": {
      "type": "string",
      "title": "\u0645\u062e\u0635\u0635 \u0644\u0644\u0645\u0648\u0638\u0641"
    },
    "assigned_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u062e\u0635\u064a\u0635"
    },
    "delivered_by": {
      "type": "string",
      "title": "\u0633\u064f\u0644\u0650\u0651\u0645 \u0628\u0648\u0627\u0633\u0637\u0629"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0633\u0644\u064a\u0645"
    },
    "condition_at_delivery": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629 \u0639\u0646\u062f \u0627\u0644\u062a\u0633\u0644\u064a\u0645"
    },
    "received_by": {
      "type": "string",
      "title": "\u0627\u0633\u062a\u064f\u0644\u0645 \u0628\u0648\u0627\u0633\u0637\u0629"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    },
    "history": {
      "type": "array",
      "title": "\u0633\u062c\u0644 \u0627\u0644\u0623\u0635\u0644",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "performed_by": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "asset_name",
    "asset_type"
  ]
}