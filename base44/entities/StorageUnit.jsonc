    },
    "length_m": {
      "type": "number",
      "title": "\u0627\u0644\u0637\u0648\u0644 (\u0645)",
      "default": 0
    },
    "width_m": {
      "type": "number",
      "title": "\u0627\u0644\u0639\u0631\u0636 (\u0645)",
      "default": 0
    },
    "height_m": {
      "type": "number",
      "title": "\u0627\u0644\u0627\u0631\u062a\u0641\u0627\u0639 (\u0645)",
      "default": 0
    },
    "monthly_price": {
      "type": "number",
      "title": "\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0634\u0647\u0631\u064a (\u0631.\u0633)",
      "default": 0
    },
