{
  "name": "Bonus",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0642\u0633\u0645"
    },
    "bonus_type": {
      "type": "string",
      "enum": [
        "\u0645\u0643\u0627\u0641\u0623\u0629 \u0623\u062f\u0627\u0621",
        "\u0645\u0643\u0627\u0641\u0623\u0629 \u0625\u0646\u062c\u0627\u0632",
        "\u0645\u0643\u0627\u0641\u0623\u0629 \u0633\u0646\u0648\u064a\u0629",
        "\u0645\u0643\u0627\u0641\u0623\u0629 \u0631\u0645\u0636\u0627\u0646",
        "\u0645\u0643\u0627\u0641\u0623\u0629 \u0639\u064a\u062f",
        "\u0645\u0643\u0627\u0641\u0623\u0629 \u0645\u0634\u0631\u0648\u0639",
        "\u0623\u062e\u0631\u0649"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0645\u0643\u0627\u0641\u0623\u0629"
    },
    "scope": {
      "type": "string",
      "enum": [
        "\u0641\u0631\u062f\u064a\u0629",
        "\u0642\u0633\u0645",
        "\u0627\u0644\u0634\u0631\u0643\u0629"
      ],
      "title": "\u0627\u0644\u0646\u0637\u0627\u0642",
      "default": "\u0641\u0631\u062f\u064a\u0629"
    },
    "amount": {
      "type": "number",
      "title": "\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0643\u0627\u0641\u0623\u0629",
      "default": 0
    },
    "reason": {
      "type": "string",
      "title": "\u0633\u0628\u0628 \u0627\u0644\u0645\u0643\u0627\u0641\u0623\u0629"
    },
    "period": {
      "type": "string",
      "title": "\u0627\u0644\u0641\u062a\u0631\u0629 / \u0627\u0644\u0634\u0647\u0631"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0642\u064a\u062f \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f",
        "\u0645\u0639\u062a\u0645\u062f\u0629",
        "\u0645\u062f\u0641\u0648\u0639\u0629",
        "\u0645\u0631\u0641\u0648\u0636\u0629"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "\u0642\u064a\u062f \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f"
    },
    "approved_by": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0639\u062a\u0645\u062f"
    },
    "approval_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f"
    },
    "requires_gm_approval": {
      "type": "boolean",
      "title": "\u062a\u062d\u062a\u0627\u062c \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u0639\u0627\u0645",
      "default": false
    }
  },
  "required": [
    "employee_name",
    "bonus_type",
    "amount"
  ]
}