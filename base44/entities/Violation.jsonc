{
  "name": "Violation",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0642\u0633\u0645"
    },
    "violation_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0629",
      "enum": [
        "\u062a\u0623\u062e\u0631 \u0645\u062a\u0643\u0631\u0631",
        "\u063a\u064a\u0627\u0628 \u0628\u062f\u0648\u0646 \u0625\u0630\u0646",
        "\u0645\u062e\u0627\u0644\u0641\u0629 \u0633\u0644\u0648\u0643\u064a\u0629",
        "\u0645\u062e\u0627\u0644\u0641\u0629 \u0625\u062c\u0631\u0627\u0621\u0627\u062a",
        "\u0625\u0647\u0645\u0627\u0644 \u0641\u064a \u0627\u0644\u0639\u0645\u0644",
        "\u0645\u062e\u0627\u0644\u0641\u0629 \u0623\u0645\u0646 \u0645\u0639\u0644\u0648\u0645\u0627\u062a",
        "\u0623\u062e\u0631\u0649"
      ]
    },
    "description": {
      "type": "string",
      "title": "\u0648\u0635\u0641 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0629"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0629"
    },
    "penalty": {
      "type": "string",
      "title": "\u0627\u0644\u0639\u0642\u0648\u0628\u0629",
      "enum": [
        "\u0625\u0646\u0630\u0627\u0631 \u0634\u0641\u0647\u064a",
        "\u0625\u0646\u0630\u0627\u0631 \u0643\u062a\u0627\u0628\u064a",
        "\u062e\u0635\u0645 \u0631\u0627\u062a\u0628",
        "\u0625\u064a\u0642\u0627\u0641 \u0639\u0646 \u0627\u0644\u0639\u0645\u0644",
        "\u0625\u0646\u0647\u0627\u0621 \u062e\u062f\u0645\u0629",
        "\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
      ]
    },
    "penalty_days": {
      "type": "number",
      "title": "\u0623\u064a\u0627\u0645 \u0627\u0644\u062e\u0635\u0645/\u0627\u0644\u0625\u064a\u0642\u0627\u0641",
      "default": 0
    },
    "penalty_amount": {
      "type": "number",
      "title": "\u0645\u0628\u0644\u063a \u0627\u0644\u062e\u0635\u0645 (\u0631\u064a\u0627\u0644)",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629",
        "\u0645\u0624\u0643\u062f\u0629",
        "\u0645\u0644\u063a\u0627\u0629"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "issued_by": {
      "type": "string",
      "title": "\u0635\u0627\u062f\u0631\u0629 \u0645\u0646"
    },
    "employee_acknowledgment": {
      "type": "boolean",
      "title": "\u0625\u0642\u0631\u0627\u0631 \u0627\u0644\u0645\u0648\u0638\u0641",
      "default": false
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "violation_type",
    "date"
  ]
}