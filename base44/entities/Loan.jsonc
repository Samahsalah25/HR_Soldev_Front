{
  "name": "Loan",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0642\u0633\u0645"
    },
    "amount": {
      "type": "number",
      "title": "\u0645\u0628\u0644\u063a \u0627\u0644\u0633\u0644\u0641\u0629",
      "default": 0
    },
    "reason": {
      "type": "string",
      "title": "\u0633\u0628\u0628 \u0627\u0644\u0633\u0644\u0641\u0629"
    },
    "installments": {
      "type": "number",
      "title": "\u0639\u062f\u062f \u0627\u0644\u0623\u0642\u0633\u0627\u0637",
      "default": 1
    },
    "monthly_deduction": {
      "type": "number",
      "title": "\u0627\u0644\u062e\u0635\u0645 \u0627\u0644\u0634\u0647\u0631\u064a",
      "default": 0
    },
    "paid_amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0633\u062f\u064e\u0651\u062f",
      "default": 0
    },
    "remaining_amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062a\u0628\u0642\u064a",
      "default": 0
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0635\u062f\u0627\u0631"
    },
    "expected_end_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0645\u062a\u0648\u0642\u0639"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0646\u0634\u0637\u0629",
        "\u0645\u0633\u062f\u062f\u0629 \u0628\u0627\u0644\u0643\u0627\u0645\u0644",
        "\u0645\u0644\u063a\u0627\u0629"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "\u0646\u0634\u0637\u0629"
    },
    "request_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0645\u0631\u062a\u0628\u0637"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "amount",
    "issue_date"
  ]
}