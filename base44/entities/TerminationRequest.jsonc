{
  "name": "TerminationRequest",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0642\u0633\u0645"
    },
    "job_title": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0633\u0645\u0649 \u0627\u0644\u0648\u0638\u064a\u0641\u064a"
    },
    "termination_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0625\u0646\u0647\u0627\u0621",
      "enum": [
        "Resignation",
        "Company Termination",
        "Contract End",
        "Retirement",
        "End of Probation"
      ]
    },
    "reason": {
      "type": "string",
      "title": "\u0633\u0628\u0628 \u0627\u0644\u0625\u0646\u0647\u0627\u0621"
    },
    "last_working_day": {
      "type": "string",
      "format": "date",
      "title": "\u0622\u062e\u0631 \u064a\u0648\u0645 \u0639\u0645\u0644"
    },
    "notice_period_days": {
      "type": "number",
      "title": "\u0641\u062a\u0631\u0629 \u0627\u0644\u0625\u0634\u0639\u0627\u0631 (\u0623\u064a\u0627\u0645)",
      "default": 30
    },
    "attachment_url": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0631\u0641\u0642"
    },
    "status": {
      "type": "string",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628",
      "enum": [
        "Draft",
        "Pending Manager",
        "Pending HR Review",
        "Pending Finance",
        "Pending IT/Assets",
        "Final Approval",
        "Completed",
        "Cancelled"
      ],
      "default": "Draft"
    },
    "manager_confirmed_by": {
      "type": "string",
      "title": "\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0645\u062f\u064a\u0631"
    },
    "manager_confirmed_at": {
      "type": "string",
      "title": "\u062a\u0627\u0631\u064a\u062e \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0645\u062f\u064a\u0631"
    },
    "manager_notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u062f\u064a\u0631"
    },
    "hr_reviewed_by": {
      "type": "string",
      "title": "\u0645\u0631\u0627\u062c\u0639\u0629 HR"
    },
    "hr_reviewed_at": {
      "type": "string",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0645\u0631\u0627\u062c\u0639\u0629 HR"
    },
    "hr_notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a HR"
    },
    "exit_interview_done": {
      "type": "boolean",
      "title": "\u062a\u0645\u062a \u0645\u0642\u0627\u0628\u0644\u0629 \u0627\u0644\u062e\u0631\u0648\u062c",
      "default": false
    },
    "finance_cleared_by": {
      "type": "string",
      "title": "\u062a\u062e\u0644\u064a\u0635 \u0627\u0644\u0645\u0627\u0644\u064a\u0629"
    },
    "finance_cleared_at": {
      "type": "string",
      "title": "\u062a\u0627\u0631\u064a\u062e \u062a\u062e\u0644\u064a\u0635 \u0627\u0644\u0645\u0627\u0644\u064a\u0629"
    },
    "finance_notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u064a\u0629"
    },
    "outstanding_loans": {
      "type": "number",
      "title": "\u0627\u0644\u0633\u0644\u0641 \u0627\u0644\u0645\u062a\u0628\u0642\u064a\u0629",
      "default": 0
    },
    "final_settlement_amount": {
      "type": "number",
      "title": "\u0627\u0644\u062a\u0633\u0648\u064a\u0629 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629",
      "default": 0
    },
    "it_cleared_by": {
      "type": "string",
      "title": "\u062a\u062e\u0644\u064a\u0635 IT"
    },
    "it_cleared_at": {
      "type": "string",
      "title": "\u062a\u0627\u0631\u064a\u062e \u062a\u062e\u0644\u064a\u0635 IT"
    },
    "it_notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a IT"
    },
    "assets_cleared_by": {
      "type": "string",
      "title": "\u062a\u062e\u0644\u064a\u0635 \u0627\u0644\u0639\u0647\u062f\u0629"
    },
    "assets_cleared_at": {
      "type": "string",
      "title": "\u062a\u0627\u0631\u064a\u062e \u062a\u062e\u0644\u064a\u0635 \u0627\u0644\u0639\u0647\u062f\u0629"
    },
    "assets_notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0639\u0647\u062f\u0629"
    },
    "travel_cleared_by": {
      "type": "string",
      "title": "\u062a\u062e\u0644\u064a\u0635 \u0627\u0644\u0633\u0641\u0631"
    },
    "travel_notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0633\u0641\u0631"
    },
    "final_approved_by": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629"
    },
    "final_approved_at": {
      "type": "string",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629"
    },
    "salary_stopped": {
      "type": "boolean",
      "title": "\u062a\u0645 \u0625\u064a\u0642\u0627\u0641 \u0627\u0644\u0631\u0627\u062a\u0628",
      "default": false
    },
    "insurance_terminated": {
      "type": "boolean",
      "title": "\u062a\u0645 \u0625\u0646\u0647\u0627\u0621 \u0627\u0644\u062a\u0623\u0645\u064a\u0646",
      "default": false
    },
    "account_disabled": {
      "type": "boolean",
      "title": "\u062a\u0645 \u062a\u0639\u0637\u064a\u0644 \u0627\u0644\u062d\u0633\u0627\u0628",
      "default": false
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "termination_type",
    "last_working_day",
    "reason"
  ]
}