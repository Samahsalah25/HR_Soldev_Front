{
  "name": "AssetRequest",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0623\u0635\u0644"
    },
    "asset_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0623\u0635\u0644"
    },
    "asset_category": {
      "type": "string",
      "title": "\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0623\u0635\u0644"
    },
    "employee_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0642\u0633\u0645"
    },
    "request_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0637\u0644\u0628",
      "enum": [
        "\u0637\u0644\u0628 \u0623\u0635\u0644",
        "\u0625\u0639\u0627\u062f\u0629 \u0623\u0635\u0644"
      ],
      "default": "\u0637\u0644\u0628 \u0623\u0635\u0644"
    },
    "reason": {
      "type": "string",
      "title": "\u0633\u0628\u0628 \u0627\u0644\u0637\u0644\u0628"
    },
    "status": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "enum": [
        "\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629",
        "\u0645\u0642\u0628\u0648\u0644",
        "\u0645\u0631\u0641\u0648\u0636",
        "\u0645\u0646\u062c\u0632"
      ],
      "default": "\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "reviewed_by": {
      "type": "string",
      "title": "\u062a\u0645\u062a \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0628\u0648\u0627\u0633\u0637\u0629"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "delivered_by": {
      "type": "string",
      "title": "\u0633\u064f\u0644\u0650\u0651\u0645 \u0628\u0648\u0627\u0633\u0637\u0629"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u0633\u0644\u064a\u0645"
    },
    "condition_at_delivery": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629 \u0639\u0646\u062f \u0627\u0644\u062a\u0633\u0644\u064a\u0645"
    },
    "received_by": {
      "type": "string",
      "title": "\u0627\u0633\u062a\u064f\u0644\u0645 \u0628\u0648\u0627\u0633\u0637\u0629"
    },
    "return_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0639\u0627\u062f\u0629"
    },
    "condition_at_return": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629 \u0639\u0646\u062f \u0627\u0644\u0625\u0639\u0627\u062f\u0629"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "asset_id",
    "asset_name",
    "employee_id",
    "employee_name"
  ]
}