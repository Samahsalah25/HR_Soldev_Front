        "\u0645\u0635\u0631\u0648\u0641\u0627\u062a"
      ]
    },
    "account_category": {
      "type": "string",
      "title": "\u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0641\u0631\u0639\u064a",
      "enum": [
        "\u0623\u0635\u0648\u0644 \u0645\u062a\u062f\u0627\u0648\u0644\u0629",
        "\u0623\u0635\u0648\u0644 \u062b\u0627\u0628\u062a\u0629",
        "\u0627\u0644\u062a\u0632\u0627\u0645\u0627\u062a \u0645\u062a\u062f\u0627\u0648\u0644\u0629",
        "\u0627\u0644\u062a\u0632\u0627\u0645\u0627\u062a \u0637\u0648\u064a\u0644\u0629 \u0627\u0644\u0623\u062c\u0644",
        "\u0631\u0623\u0633 \u0627\u0644\u0645\u0627\u0644",
        "\u0625\u064a\u0631\u0627\u062f\u0627\u062a \u062a\u0634\u063a\u064a\u0644\u064a\u0629",
        "\u0625\u064a\u0631\u0627\u062f\u0627\u062a \u0623\u062e\u0631\u0649",
        "\u0645\u0635\u0631\u0648\u0641\u0627\u062a \u062a\u0634\u063a\u064a\u0644\u064a\u0629",
        "\u0645\u0635\u0631\u0648\u0641\u0627\u062a \u0625\u062f\u0627\u0631\u064a\u0629",
