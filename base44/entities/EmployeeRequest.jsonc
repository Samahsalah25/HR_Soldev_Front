{
  "name": "EmployeeRequest",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0642\u0633\u0645"
    },
    "request_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0637\u0644\u0628",
      "enum": [
        "\u0637\u0644\u0628 \u0625\u062c\u0627\u0632\u0629",
        "\u062a\u0642\u062f\u064a\u0645 \u0634\u0643\u0648\u0649",
        "\u062a\u0642\u062f\u064a\u0645 \u0627\u0639\u062a\u0631\u0627\u0636",
        "\u0637\u0644\u0628 \u0628\u062f\u0644",
        "\u0637\u0644\u0628 \u0639\u0647\u062f\u0629",
        "\u062a\u0635\u0641\u064a\u0629 \u0639\u0647\u062f\u0629",
        "\u0637\u0644\u0628 \u0633\u0644\u0641\u0629",
        "\u0631\u0641\u0639 \u0645\u0635\u0631\u0648\u0641/\u0641\u0627\u062a\u0648\u0631\u0629"
      ]
    },
    "details": {
      "type": "string",
      "title": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0637\u0644\u0628"
    },
    "amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a (\u0625\u0646 \u0648\u062c\u062f)",
      "default": 0
    },
    "attachment_url": {
      "type": "string",
      "title": "\u0645\u0631\u0641\u0642"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629",
        "\u0645\u0642\u0628\u0648\u0644\u0629",
        "\u0645\u0631\u0641\u0648\u0636\u0629"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "reviewer_notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u062c\u0639"
    },
    "reviewed_by": {
      "type": "string",
      "title": "\u0631\u0627\u062c\u0639\u0647\u0627"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    }
  },
  "required": [
    "employee_name",
    "request_type",
    "details"
  ]
}