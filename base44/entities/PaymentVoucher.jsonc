      "title": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639",
      "default": "\u0646\u0642\u062f\u0627\u064b"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641"
    },
    "reference": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0631\u062c\u0639"
