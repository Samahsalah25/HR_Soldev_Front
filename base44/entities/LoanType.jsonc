{
  "name": "LoanType",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0646\u0648\u0639 \u0627\u0644\u0633\u0644\u0641\u0629"
    },
    "name_en": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645 \u0628\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629"
    },
    "description": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0635\u0641"
    },
    "max_amount": {
      "type": "number",
      "title": "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0645\u0628\u0644\u063a (\u0631\u064a\u0627\u0644)",
      "default": 0
    },
    "max_installments": {
      "type": "number",
      "title": "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0623\u0642\u0633\u0627\u0637",
      "default": 12
    },
    "salary_ratio": {
      "type": "number",
      "title": "\u0646\u0633\u0628\u0629 \u0645\u0646 \u0627\u0644\u0631\u0627\u062a\u0628 \u0627\u0644\u0623\u0633\u0627\u0633\u064a (\u0645\u062b\u0644\u0627\u064b 3 = 3 \u0631\u0648\u0627\u062a\u0628)",
      "default": 3
    },
    "min_service_months": {
      "type": "number",
      "title": "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0645\u0646 \u0627\u0644\u062e\u062f\u0645\u0629 (\u0623\u0634\u0647\u0631)",
      "default": 6
    },
    "requires_manager_approval": {
      "type": "boolean",
      "title": "\u064a\u062a\u0637\u0644\u0628 \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u062f\u064a\u0631",
      "default": true
    },
    "requires_hr_approval": {
      "type": "boolean",
      "title": "\u064a\u062a\u0637\u0644\u0628 \u0645\u0648\u0627\u0641\u0642\u0629 HR",
      "default": true
    },
    "requires_finance_approval": {
      "type": "boolean",
      "title": "\u064a\u062a\u0637\u0644\u0628 \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629",
      "default": false
    },
    "finance_approval_threshold": {
      "type": "number",
      "title": "\u062d\u062f \u0645\u0628\u0644\u063a \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629 (\u0631\u064a\u0627\u0644)",
      "default": 10000
    },
    "is_active": {
      "type": "boolean",
      "title": "\u0645\u0641\u0639\u0651\u0644",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}