{
  "name": "Deduction",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0642\u0633\u0645"
    },
    "deduction_type": {
      "type": "string",
      "enum": [
        "\u062e\u0635\u0645 \u063a\u064a\u0627\u0628",
        "\u062e\u0635\u0645 \u062a\u0623\u062e\u064a\u0631",
        "\u062e\u0635\u0645 \u0645\u062e\u0627\u0644\u0641\u0629",
        "\u062e\u0635\u0645 \u0642\u0633\u0637 \u0633\u0644\u0641\u0629",
        "\u062e\u0635\u0645 \u062a\u0623\u0645\u064a\u0646\u064a",
        "\u062e\u0635\u0645 \u0625\u062f\u0627\u0631\u064a",
        "\u0623\u062e\u0631\u0649"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u062e\u0635\u0645"
    },
    "amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a",
      "default": 0
    },
    "reason": {
      "type": "string",
      "title": "\u0627\u0644\u0633\u0628\u0628 \u0627\u0644\u062a\u0641\u0635\u064a\u0644\u064a"
    },
    "month": {
      "type": "string",
      "title": "\u0634\u0647\u0631 \u0627\u0644\u062e\u0635\u0645 (YYYY-MM)"
    },
    "violation_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u062e\u0627\u0644\u0641\u0629 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0642\u064a\u062f \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f",
        "\u0645\u0639\u062a\u0645\u062f",
        "\u0645\u0637\u0628\u0651\u0642",
        "\u0645\u0631\u0641\u0648\u0636",
        "\u0645\u064f\u0644\u063a\u0649"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "\u0642\u064a\u062f \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f"
    },
    "requires_approval": {
      "type": "boolean",
      "title": "\u064a\u062d\u062a\u0627\u062c \u0642\u0631\u0627\u0631 \u0625\u062f\u0627\u0631\u064a",
      "default": true
    },
    "approved_by": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0639\u062a\u0645\u062f"
    },
    "approval_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "deduction_type",
    "amount",
    "month"
  ]
}