    "longitude": {
      "type": "number",
      "title": "\u062e\u0637 \u0627\u0644\u0637\u0648\u0644 (Longitude)"
    },
    "radius_meters": {
      "type": "number",
      "title": "\u0646\u0637\u0627\u0642 \u0627\u0644\u062d\u0636\u0648\u0631 (\u0645\u062a\u0631)",
