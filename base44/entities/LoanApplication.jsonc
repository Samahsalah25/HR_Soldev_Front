{
  "name": "LoanApplication",
  "type": "object",
  "properties": {
    "loan_type_id": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0633\u0644\u0641\u0629 (ID)"
    },
    "loan_type_name": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0633\u0644\u0641\u0629"
    },
    "employee_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "department": {
      "type": "string",
      "title": "\u0627\u0644\u0642\u0633\u0645"
    },
    "basic_salary": {
      "type": "number",
      "title": "\u0627\u0644\u0631\u0627\u062a\u0628 \u0627\u0644\u0623\u0633\u0627\u0633\u064a \u0648\u0642\u062a \u0627\u0644\u0637\u0644\u0628",
      "default": 0
    },
    "amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0637\u0644\u0648\u0628",
      "default": 0
    },
    "installments": {
      "type": "number",
      "title": "\u0639\u062f\u062f \u0627\u0644\u0623\u0642\u0633\u0627\u0637",
      "default": 1
    },
    "monthly_deduction": {
      "type": "number",
      "title": "\u0627\u0644\u0642\u0633\u0637 \u0627\u0644\u0634\u0647\u0631\u064a",
      "default": 0
    },
    "reason": {
      "type": "string",
      "title": "\u0633\u0628\u0628 \u0627\u0644\u0637\u0644\u0628"
    },
    "attachment_url": {
      "type": "string",
      "title": "\u0645\u0631\u0641\u0642 \u062f\u0627\u0639\u0645"
    },
    "status": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "enum": [
        "\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629",
        "\u0627\u0646\u062a\u0638\u0627\u0631 \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u062f\u064a\u0631",
        "\u0627\u0646\u062a\u0638\u0627\u0631 \u0645\u0648\u0627\u0641\u0642\u0629 HR",
        "\u0627\u0646\u062a\u0638\u0627\u0631 \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629",
        "\u0645\u0639\u062a\u0645\u062f\u0629",
        "\u0645\u0635\u0631\u0648\u0641\u0629",
        "\u0645\u0631\u0641\u0648\u0636\u0629",
        "\u0645\u0644\u063a\u0627\u0629"
      ],
      "default": "\u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"
    },
    "manager_approved_by": {
      "type": "string",
      "title": "\u0627\u0639\u062a\u0645\u062f \u0627\u0644\u0645\u062f\u064a\u0631"
    },
    "manager_approved_at": {
      "type": "string",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u062f\u064a\u0631"
    },
    "manager_notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u062f\u064a\u0631"
    },
    "hr_approved_by": {
      "type": "string",
      "title": "\u0627\u0639\u062a\u0645\u062f HR"
    },
    "hr_approved_at": {
      "type": "string",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0645\u0648\u0627\u0641\u0642\u0629 HR"
    },
    "hr_notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a HR"
    },
    "finance_approved_by": {
      "type": "string",
      "title": "\u0627\u0639\u062a\u0645\u062f \u0627\u0644\u0645\u0627\u0644\u064a\u0629"
    },
    "finance_approved_at": {
      "type": "string",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u0645\u0627\u0644\u064a\u0629"
    },
    "finance_notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0645\u0627\u0644\u064a\u0629"
    },
    "disbursed_by": {
      "type": "string",
      "title": "\u0635\u0631\u0641\u062a \u0628\u0648\u0627\u0633\u0637\u0629"
    },
    "disbursed_at": {
      "type": "string",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0635\u0631\u0641"
    },
    "disbursement_method": {
      "type": "string",
      "title": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0635\u0631\u0641",
      "enum": [
        "\u062a\u062d\u0648\u064a\u0644 \u0628\u0646\u0643\u064a",
        "\u0646\u0642\u062f\u0627\u064b",
        "\u062e\u0635\u0645 \u0645\u0646 \u0627\u0644\u0631\u0627\u062a\u0628"
      ]
    },
    "loan_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0633\u0644\u0641\u0629 \u0627\u0644\u0645\u0646\u0634\u0623\u0629"
    },
    "rejection_reason": {
      "type": "string",
      "title": "\u0633\u0628\u0628 \u0627\u0644\u0631\u0641\u0636"
    },
    "start_deduction_month": {
      "type": "string",
      "title": "\u0634\u0647\u0631 \u0628\u062f\u0621 \u0627\u0644\u062e\u0635\u0645 (YYYY-MM)"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "amount",
    "installments",
    "reason"
  ]
}