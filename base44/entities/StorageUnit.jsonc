      "title": "\u0627\u0633\u0645 \u0627\u0644\u0648\u062d\u062f\u0629"
    },
    "branch": {
      "type": "string",
      "title": "\u0627\u0644\u0641\u0631\u0639 / \u0627\u0644\u0645\u0648\u0642\u0639"
    },
    "unit_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0648\u062d\u062f\u0629",
