      "title": "\u0631\u0642\u0645 \u0627\u0644\u062d\u062c\u0632"
    },
    "unit_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0648\u062d\u062f\u0629"
    },
    "unit_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0648\u062d\u062f\u0629"
    },
    "unit_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0648\u062d\u062f\u0629"
    },
    "branch": {
      "type": "string",
      "title": "\u0627\u0644\u0641\u0631\u0639"
    },
    "monthly_price": {
      "type": "number",
      "title": "\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0634\u0647\u0631\u064a",
      "default": 0
    },
    "customer_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0639\u0645\u064a\u0644",
      "enum": [
        "\u0641\u0631\u062f",
        "\u0634\u0631\u0643\u0629"
      ],
      "default": "\u0641\u0631\u062f"
    },
    "full_name": {
      "type": "string",
      "title": "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0643\u0627\u0645\u0644"
    },
    "phone": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0644"
    },
    "email": {
      "type": "string",
      "title": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a"
    },
    "id_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0648\u064a\u0629 / \u0627\u0644\u0625\u0642\u0627\u0645\u0629"
    },
    "birth_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u064a\u0644\u0627\u062f"
    },
    "company_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629"
    },
    "company_rep": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0641\u0648\u0636"
    },
    "commercial_reg": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "tax_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a"
    },
    "storage_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0645\u062e\u0632\u0648\u0646"
    },
    "id_image_url": {
      "type": "string",
      "title": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0647\u0648\u064a\u0629"
    },
    "commercial_reg_url": {
      "type": "string",
      "title": "\u0645\u0644\u0641 \u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "tax_cert_url": {
      "type": "string",
      "title": "\u0634\u0647\u0627\u062f\u0629 \u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a"
    },
    "auth_doc_url": {
      "type": "string",
      "title": "\u0645\u0633\u062a\u0646\u062f \u0627\u0644\u062a\u0641\u0648\u064a\u0636"
    },
    "contract_start": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0639\u0642\u062f"
    },
    "contract_months": {
      "type": "number",
      "title": "\u0645\u062f\u0629 \u0627\u0644\u0639\u0642\u062f (\u0623\u0634\u0647\u0631)",
      "default": 1
    },
    "terms_accepted": {
      "type": "boolean",
      "title": "\u0642\u0628\u0648\u0644 \u0627\u0644\u0634\u0631\u0648\u0637",
      "default": false
    },
    "terms_accepted_at": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0642\u0628\u0648\u0644 \u0627\u0644\u0634\u0631\u0648\u0637"
    },
    "terms_version": {
      "type": "string",
      "title": "\u0646\u0633\u062e\u0629 \u0627\u0644\u0634\u0631\u0648\u0637",
      "default": "v1.0"
    },
    "signature_image": {
      "type": "string",
      "title": "\u0635\u0648\u0631\u0629 \u0627\u0644\u062a\u0648\u0642\u064a\u0639 (base64)"
    },
    "signature_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0642\u0639"
    },
    "signed_at": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u062a\u0648\u0642\u064a\u0639"
    },
    "payment_method": {
      "type": "string",
      "title": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639",
      "enum": [
        "\u0645\u062f\u0649",
        "Apple Pay",
        "\u0628\u0637\u0627\u0642\u0629 \u0627\u0626\u062a\u0645\u0627\u0646\u064a\u0629",
        "\u062a\u062d\u0648\u064a\u0644 \u0628\u0646\u0643\u064a"
      ]
    },
    "payment_ref": {
      "type": "string",
      "title": "\u0645\u0631\u062c\u0639 \u0627\u0644\u062f\u0641\u0639"
    },
    "paid_at": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u062f\u0641\u0639"
    },
    "total_amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a",
      "default": 0
    },
    "paid_amount": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u062f\u0641\u0648\u0639",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062d\u062c\u0632",
      "enum": [
        "Draft",
        "Pending Terms Approval",
        "Pending Signature",
        "Pending Payment",
        "Confirmed",
        "Cancelled",
        "Expired"
      ],
      "default": "Draft"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "unit_id",
    "customer_type",
    "full_name",
    "phone",
    "email"
  ],
  "rls": {
    "read": true,
    "create": true,
    "update": true,
    "delete": false
  }
}