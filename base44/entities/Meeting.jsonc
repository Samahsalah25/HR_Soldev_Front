{
  "name": "Meeting",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639"
    },
    "type": {
      "type": "string",
      "enum": [
        "\u062f\u0627\u062e\u0644\u064a",
        "\u062e\u0627\u0631\u062c\u064a"
      ],
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639",
      "default": "\u062f\u0627\u062e\u0644\u064a"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u0627\u0644\u062a\u0627\u0631\u064a\u062e"
    },
    "time": {
      "type": "string",
      "title": "\u0627\u0644\u0648\u0642\u062a"
    },
    "duration_minutes": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u062f\u0629 (\u062f\u0642\u064a\u0642\u0629)",
      "default": 60
    },
    "location": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0643\u0627\u0646 / \u0631\u0627\u0628\u0637 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639"
    },
    "organizer": {
      "type": "string",
      "title": "\u0627\u0644\u0645\u0646\u0638\u0645"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u0627\u0644\u062d\u0636\u0648\u0631 (\u0623\u0633\u0645\u0627\u0621)"
    },
    "assigned_employee_id": {
      "type": "string",
      "title": "\u0645\u0648\u0638\u0641 \u0645\u0633\u0624\u0648\u0644 (ID)"
    },
    "assigned_employee_name": {
      "type": "string",
      "title": "\u0645\u0648\u0638\u0641 \u0645\u0633\u0624\u0648\u0644"
    },
    "external_company": {
      "type": "string",
      "title": "\u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629"
    },
    "agenda": {
      "type": "string",
      "title": "\u062c\u062f\u0648\u0644 \u0627\u0644\u0623\u0639\u0645\u0627\u0644"
    },
    "minutes": {
      "type": "string",
      "title": "\u0645\u062d\u0636\u0631 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0645\u062c\u062f\u0648\u0644",
        "\u0645\u0643\u062a\u0645\u0644",
        "\u0645\u0644\u063a\u0649"
      ],
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "default": "\u0645\u062c\u062f\u0648\u0644"
    }
  },
  "required": [
    "title",
    "date",
    "type"
  ]
}