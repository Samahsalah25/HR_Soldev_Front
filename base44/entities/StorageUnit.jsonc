        "\u0645\u0643\u064a\u0641",
        "\u063a\u064a\u0631 \u0645\u0643\u064a\u0641"
      ],
      "default": "\u063a\u064a\u0631 \u0645\u0643\u064a\u0641"
    },
    "area_sqm": {
      "type": "number",
      "title": "\u0627\u0644\u0645\u0633\u0627\u062d\u0629 (\u0645\u00b2)",
