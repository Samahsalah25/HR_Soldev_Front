      "default": "\u0645\u062a\u0627\u062d\u0629"
    },
    "image_url": {
      "type": "string",
      "title": "\u0635\u0648\u0631\u0629 \u0627\u0644\u0648\u062d\u062f\u0629"
    },
    "description": {
      "type": "string",
      "title": "\u0648\u0635\u0641 \u0627\u0644\u0648\u062d\u062f\u0629"
    },
    "has_security": {
      "type": "boolean",
      "title": "\u0623\u0645\u0627\u0646 24/7",
