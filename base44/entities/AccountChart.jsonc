        "\u0623\u062e\u0631\u0649"
      ]
    },
    "parent_account_id": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0623\u0628"
    },
    "parent_account_code": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0623\u0628"
    },
    "level": {
      "type": "number",
      "title": "\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062d\u0633\u0627\u0628",
