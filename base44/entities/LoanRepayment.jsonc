{
  "name": "LoanRepayment",
  "type": "object",
  "properties": {
    "loan_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0633\u0644\u0641\u0629"
    },
    "employee_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "employee_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"
    },
    "installment_number": {
      "type": "number",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0642\u0633\u0637",
      "default": 1
    },
    "due_month": {
      "type": "string",
      "title": "\u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0645\u0633\u062a\u062d\u0642 (YYYY-MM)"
    },
    "amount": {
      "type": "number",
      "title": "\u0642\u064a\u0645\u0629 \u0627\u0644\u0642\u0633\u0637",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "enum": [
        "\u0645\u062c\u062f\u0648\u0644",
        "\u0645\u062f\u0641\u0648\u0639",
        "\u0645\u0624\u062c\u0644",
        "\u0625\u062c\u0627\u0632\u0629 \u0628\u062f\u0648\u0646 \u0631\u0627\u062a\u0628"
      ],
      "default": "\u0645\u062c\u062f\u0648\u0644"
    },
    "paid_at": {
      "type": "string",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0633\u062f\u0627\u062f"
    },
    "paid_by": {
      "type": "string",
      "title": "\u0633\u064f\u062f\u0650\u0651\u062f \u0628\u0648\u0627\u0633\u0637\u0629"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "loan_id",
    "employee_id",
    "installment_number",
    "due_month",
    "amount"
  ]
}