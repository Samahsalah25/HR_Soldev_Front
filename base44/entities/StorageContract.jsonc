{
  "name": "StorageContract",
  "type": "object",
  "properties": {
    "contract_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0639\u0642\u062f"
    },
    "booking_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u062d\u062c\u0632"
    },
    "booking_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u062d\u062c\u0632"
    },
    "customer_email": {
      "type": "string",
      "title": "\u0628\u0631\u064a\u062f \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_phone": {
      "type": "string",
      "title": "\u062c\u0648\u0627\u0644 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_id_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0647\u0648\u064a\u0629 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "customer_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0639\u0645\u064a\u0644"
    },
    "company_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0634\u0631\u0643\u0629 (\u0644\u0644\u0634\u0631\u0643\u0627\u062a)"
    },
    "commercial_reg": {
      "type": "string",
      "title": "\u0627\u0644\u0633\u062c\u0644 \u0627\u0644\u062a\u062c\u0627\u0631\u064a"
    },
    "tax_number": {
      "type": "string",
      "title": "\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0636\u0631\u064a\u0628\u064a"
    },
    "unit_id": {
      "type": "string",
      "title": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0648\u062d\u062f\u0629"
    },
    "unit_number": {
      "type": "string",
      "title": "\u0631\u0642\u0645 \u0627\u0644\u0648\u062d\u062f\u0629"
    },
    "unit_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0648\u062d\u062f\u0629"
    },
    "branch": {
      "type": "string",
      "title": "\u0627\u0644\u0641\u0631\u0639"
    },
    "storage_type": {
      "type": "string",
      "title": "\u0646\u0648\u0639 \u0627\u0644\u0645\u062e\u0632\u0648\u0646"
    },
    "monthly_price": {
      "type": "number",
      "title": "\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0634\u0647\u0631\u064a",
      "default": 0
    },
    "contract_months": {
      "type": "number",
      "title": "\u0645\u062f\u0629 \u0627\u0644\u0639\u0642\u062f (\u0623\u0634\u0647\u0631)",
      "default": 1
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0628\u062f\u0627\u064a\u0629"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0646\u062a\u0647\u0627\u0621"
    },
    "next_renewal_date": {
      "type": "string",
      "format": "date",
      "title": "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062a\u062c\u062f\u064a\u062f \u0627\u0644\u0642\u0627\u062f\u0645"
    },
    "auto_renew": {
      "type": "boolean",
      "title": "\u062a\u062c\u062f\u064a\u062f \u062a\u0644\u0642\u0627\u0626\u064a",
      "default": true
    },
    "signature_image": {
      "type": "string",
      "title": "\u0635\u0648\u0631\u0629 \u0627\u0644\u062a\u0648\u0642\u064a\u0639"
    },
    "signature_name": {
      "type": "string",
      "title": "\u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0642\u0639"
    },
    "signed_at": {
      "type": "string",
      "title": "\u0648\u0642\u062a \u0627\u0644\u062a\u0648\u0642\u064a\u0639"
    },
    "status": {
      "type": "string",
      "title": "\u0627\u0644\u062d\u0627\u0644\u0629",
      "enum": [
        "\u0646\u0634\u0637",
        "\u0645\u0646\u062a\u0647\u064a",
        "\u0645\u0644\u063a\u064a",
        "\u0645\u0648\u0642\u0648\u0641"
      ],
      "default": "\u0646\u0634\u0637"
    },
    "notes": {
      "type": "string",
      "title": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a"
    }
  },
  "required": [
    "booking_id",
    "customer_email",
    "unit_number",
    "start_date"
  ],
  "rls": {
    "read": true,
    "create": true,
    "update": false,
    "delete": false
  }
}